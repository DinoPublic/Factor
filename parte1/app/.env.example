APP_NAME="API Lecturas"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Conexión al servicio db de docker compose
DB_CONNECTION=sqlsrv
DB_HOST=db
DB_PORT=1433
DB_DATABASE=lecturas
DB_USERNAME=sa
DB_PASSWORD=Prueba.Tecnica.2026
DB_TRUST_SERVER_CERTIFICATE=true

# Token que la distribuidora envía en "Authorization: Bearer <token>"
DISTRIBUIDORA_API_TOKEN=token-distribuidora-pruebas

# Procesos de "php artisan serve" para atender peticiones en paralelo
PHP_CLI_SERVER_WORKERS=4

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
